    },
    "m_SourceType": 1,
    "m_FunctionName": "RotateDirection",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Out = Direction + 2.0 * cross(ViewRotation.xyz, cross(ViewRotation.xyz, Direction) + ViewRotation.w * Direction);"
}

